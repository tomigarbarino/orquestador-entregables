{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orquestador-entregables.local/esquema/receta.schema.json",
  "title": "Receta de un entregable",
  "description": "Estructura que la interfaz dibuja y el orquestador ejecuta: disparador, fuentes, pasos, control y destino.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nombre", "descripcion", "disparador", "fuentes", "pasos", "control", "destino"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "nombre": { "type": "string", "minLength": 1 },
    "descripcion": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "disparador": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["horario", "a_pedido"] },
        "por_defecto": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dias": { "type": "array", "items": { "enum": ["lun", "mar", "mie", "jue", "vie", "sab", "dom"] } },
            "hora": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        },
        "frases": { "type": "array", "items": { "type": "string" }, "description": "Pedidos que disparan esta receta." },
        "ventana": {
          "enum": ["dia_habil_anterior", "hoy", "ultimos_7_dias", "desde_ultima_corrida", "evento"],
          "description": "Qué período cubre cada corrida."
        }
      }
    },
    "fuentes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "para"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "para": { "type": "string", "description": "Qué se busca en esta fuente." },
          "requerida": { "type": "boolean" }
        }
      }
    },
    "pasos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nombre"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "nombre": { "type": "string", "minLength": 1 },
          "detalle": { "type": "string" },
          "usa": { "type": "array", "items": { "type": "string" }, "description": "Fuentes que lee este paso." }
        }
      }
    },
    "control": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Reglas del control de evidencia: si no hay evidencia, no se cuenta."
    },
    "destino": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formato"],
      "properties": {
        "por_defecto": { "enum": ["borrador", "slack", "doc", "formulario"] },
        "formato": { "type": "string", "minLength": 1 }
      }
    },
    "reglas": {
      "type": "array",
      "description": "Correcciones aprendidas, cada una con su fecha.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fecha", "texto"],
        "properties": {
          "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "texto": { "type": "string", "minLength": 1 },
          "origen": { "type": "string" }
        }
      }
    }
  }
}
